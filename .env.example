# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true

# Database
DB_URL=postgresql+psycopg://apple_review_user:apple_review_pass@localhost:5444/reviews_db

# Redis
REDIS_URL=redis://localhost:6380/0
REDIS_TTL_SECONDS=172800

# Scraper
SCRAPER_BASE_URL=https://itunes.apple.com
SCRAPER_DEFAULT_REVIEW_COUNT=100
SCRAPER_MAX_REVIEW_COUNT=500

# BERT model
BERT_MODEL_PATH=ml/artifacts/bert/bert-sentiment-v1
BERT_MAX_LENGTH=128

# Classical model (TF-IDF + Logistic Regression)
CLASSICAL_MODEL_PATH=ml/artifacts/classical/tfidf_logreg_v1.joblib
